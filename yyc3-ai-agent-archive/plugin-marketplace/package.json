    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "eventemitter3": "^5.0.0",
    "semver": "^7.0.0"
  },
  "devDependencies": {
