    "@types/semver": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@yyc3/store": "workspace:*",
    "tsup": "8.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
