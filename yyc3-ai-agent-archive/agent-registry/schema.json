{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-agent.yyc3.vip/schemas/agent-registry.schema.json",
  "title": "YYC³ Agent 角色注册表 Schema",
  "description": "校验 packages/agent-registry/registry.json 的结构与字段约束",
  "type": "object",
  "required": ["version", "roles", "stats"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "roles": {
      "type": "array",
      "items": { "$ref": "#/definitions/role" }
    },
    "stats": {
      "type": "object",
      "required": ["totalRoles", "byCategory"],
      "properties": {
        "totalRoles": {
          "type": "integer",
          "minimum": 0,
          "description": "必须等于 roles 数组长度"
        },
        "byCategory": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "duplicatesRemoved": { "type": "integer", "minimum": 0 },
        "duplicatesNote": { "type": "string" }
      }
    }
  },
  "definitions": {
    "role": {
      "type": "object",
      "required": ["id", "name", "description", "category", "source", "capabilities", "tags", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AGT-[a-z0-9-]+$",
          "description": "统一前缀 AGT- 的 kebab-case 标识符"
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "enum": [
            "engineering",
            "workflow",
            "language-expert",
            "automation",
            "verification",
            "domain-expert",
            "creative"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^agents-hub/.+\\.md$",
          "description": "相对于仓库根目录的角色档案路径"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "status": { "type": "string", "enum": ["active", "deprecated", "draft"] }
      },
      "additionalProperties": false
    }
  }
}
