{
  "name": "@yyc3/mcp-runtime",
  "version": "1.5.0",
  "description": "YYC³ 统一 MCP 运行时 — 整合 4 套 MCP 实现 + Skill 桥接 + CowAgent 工具适配",
  "author": "YanYuCloudCube Team <admin@0379.email>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^1.18.0",
    "@yyc3/skill-registry": "workspace:*",
