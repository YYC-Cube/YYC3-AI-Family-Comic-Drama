# @file .env.example (core/config/)
# @description YYC³ 核心配置环境变量示例（与根目录同步维护）
# @version v2.0.0 | @updated 2026-07-27
# ============================================================
# 完整变量清单及释义详见: docs/YYC3-全局全链路综合总结报告.md
# ============================================================

# ═══ 基础 ═══════════════════════════════════════════════════
ENVIRONMENT=production
HOST_IP=<YOUR_TAILSCALE_IP>
# 【占位】实际为 Tailscale IP，如 100.65.172.88 (NAS)
HOST_IP_SUFFIX=<NODE_ID>
# 【占位】节点编号：22/45/33/101/102

# ═══ 数据库 ═════════════════════════════════════════════════
DB_HOST=<DB_HOST>
# 【占位】Docker环境=postgres，NAS宿主机=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=<STRONG_PASSWORD>
DB_NAME=yyc3_gpt

POSTGRES_PASSWORD=<STRONG_PASSWORD>
REPLICATOR_PASSWORD=<STRONG_PASSWORD>

# ═══ Redis ═══════════════════════════════════════════════════
REDIS_HOST=<REDIS_HOST>
# 【占位】Docker环境=redis，NAS宿主机=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# 【占位】NAS Redis 无密码，留空

# ═══ Ollama ═════════════════════════════════════════════════
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11435
# 【注意】端口已从 11434 变更为 11435
OLLAMA_MODELS=/mnt/models

# ═══ API Keys ═══════════════════════════════════════════════
OPENAI_API_KEY=
# 【占位】可选，留空=不启用
ZHIPU_API_KEY=<YOUR_ZHIPU_API_KEY>
# 【占位】当前已过期 401，需重新申请
DEEPSEEK_API_KEY=
# 【占位】可选，留空=不启用

# ═══ 认证 ═══════════════════════════════════════════════════
JWT_SECRET_KEY=<GENERATE: openssl rand -base64 64>
API_KEYS=<API_KEY_1>,<API_KEY_2>
# 管理面密钥（/v1/admin/** 专用，逗号分隔）；留空 = 回退 API_KEYS（兼容单机部署）
# 生产建议与业务 Key 分离：泄露业务 Key 无法操作虚拟密钥/上游池
ADMIN_API_KEYS=
AUTH_ENABLED=true
ALLOWED_ORIGINS=https://api.0379.world

# ═══ Traefik ════════════════════════════════════════════════
LETSENCRYPT_EMAIL=admin@0379.world
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=<STRONG_PASSWORD>
BASIC_AUTH_HASH=<GENERATE: htpasswd -nbB admin $BASIC_AUTH_PASSWORD>
CLOUDFLARE_API_TOKEN=<YOUR_CLOUDFLARE_TOKEN>

# ═══ 监控 ═══════════════════════════════════════════════════
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# ═══ 上游池（OpenAI 兼容：vLLM/NIM/SGLang）═══════════════════
# JSON 数组；为空 [] 时路由退回「云前缀 + Ollama 兜底」旧逻辑
# 字段: name/base_url 必填；models 支持 fnmatch 通配（在云前缀之后匹配）；
#       fallback_url=备用地址（QSFP 主/Tailscale 备）；api_key_env=从该环境变量读 Key；
#       priority 数字越小越优先（降级链序）；weight 加权随机；health_path 预留
# 响应头: X-YYC3-Upstream=实际服务上游；X-YYC3-Degraded=途经的失败上游（如有）
# 熔断: 连续 3 次失败摘除 30s，后半开单请求探测（/v1/router/stats 可观测）
ROUTER_ENABLED=true
OPENAI_COMPATIBLE_UPSTREAMS=[
  {
    "name": "flagship-dsv4",
    "base_url": "http://100.65.64.49:8001",
    "fallback_url": "http://10.100.168.2:8001",
    "models": ["deepseek-v4-flash", "deepseek-v4*"],
    "provider": "openai_compat",
    "priority": 1,
    "weight": 100,
    "capacity": 32
  },
  {
    "name": "ollama-n2",
    "base_url": "http://100.76.167.103:11434",
    "models": ["qwen*", "llama*"],
    "priority": 5,
    "weight": 50,
    "capacity": 16
  }
]
# provider 字段（可选，默认 openai_compat）：指定上游的请求/响应转换实现，
# 可选值见 services/providers/registry.py（openai_compat / zhipu / deepseek）。
# 例：上游为智谱兼容网关时配 "provider": "zhipu" → GLM reasoning_content 自动折叠进 content。
# 注意: JSON 须压成单行写入 env（上方展开仅为注释示例）：
# OPENAI_COMPATIBLE_UPSTREAMS=[{"name":"flagship-dsv4","base_url":"http://100.65.64.49:8001","fallback_url":"http://10.100.168.2:8001","models":["deepseek-v4-flash","deepseek-v4*"],"provider":"openai_compat","priority":1,"weight":100,"capacity":32},{"name":"ollama-n2","base_url":"http://100.76.167.103:11434","models":["qwen*","llama*"],"priority":5,"weight":50,"capacity":16}]

# ═══ 云适配器基址（默认=内置值，可不配）═══════════════════════
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# ═══ Ollama 双机（旧三端点硬编码已移除）══════════════════════
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434
OLLAMA_BACKUP_HOST=            # 第二台（如 DGX N1），留空禁用

# ── Guardrail 内容安全链（P2-1）──
# GUARDRAILS_ENABLED=false 一键关闭全链（默认开）
# GUARDRAILS_BLOCKED_TERMS=词1,词2   自定义敏感词（逗号分隔，空=纯启发式链）
# ── 云审核 Provider（可选，两者齐备才启用）──
# GUARDRAILS_CLOUD_URL=https://moderation.example.com/v1/check
# GUARDRAILS_CLOUD_KEY=your-moderation-token

# ═══ 上游池主动验活（P0-2，学 one-api 渠道自愈）══════════════
PROBE_ENABLED=true             # 启动 60s 周期探活；false 关闭
PROBE_INTERVAL_SECONDS=60      # 探活间隔；连续 2 轮失败 → degraded（权重×0.5，恢复即复原）
# 手动验活: POST /v1/admin/upstreams/probe（受 Auth 保护）

# ═══ 模型单价（P0-1 计价器，USD/1M tokens；不配则用内置默认）══
# MODEL_PRICES_JSON={"glm-4.7":{"input":1.0,"output":4.0},"deepseek-v4-flash":{"input":0.27,"output":1.10}}

# ── 能力上游（capability 路由：embedding/rerank/asr/ocr）──
# 与 chat 池同数组；端点映射: embedding→/v1/embeddings 透传, rerank→/v1/score(Cohere⇆Jina自动转换),
# asr→/v1/audio/transcriptions(multipart), ocr→/v1/ocr(multipart)
# 示例（RAG 三件套 0.6B 版, N2 部署后启用）:
# ...,{"name":"embed-n2","base_url":"http://100.76.167.103:8100","models":["qwen3-embedding-0.6b","*"],"capability":"embedding","priority":1},
#    {"name":"rerank-n2","base_url":"http://100.76.167.103:8101","models":["qwen3-reranker-0.6b","*"],"capability":"rerank","priority":1}
